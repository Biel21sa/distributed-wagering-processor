  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "migration:create": "mikro-orm migration:create --config ./mikro-orm.config.ts",
    "migration:up": "mikro-orm migration:up --config ./mikro-orm.config.ts",
    "migration:down": "mikro-orm migration:down --config ./mikro-orm.config.ts",
    "migration:check": "mikro-orm migration:check --config ./mikro-orm.config.ts",
    "migration:pending": "mikro-orm migration:pending --config ./mikro-orm.config.ts",
    "migration:list": "mikro-orm migration:list --config ./mikro-orm.config.ts"
  },
  "mikro-orm": {
    "preferTs": true,
    "tsLoader": "tsx"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.1.15",
    "@mikro-orm/decorators": "^7.1.15",
    "@mikro-orm/migrations": "^7.1.15",
